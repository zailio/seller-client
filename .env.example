# Backend API (Express) and WebSocket endpoints
NEXT_PUBLIC_SERVER_URL=https://your-backend.example.com
NEXT_PUBLIC_WS_URL=wss://your-backend.example.com/ws

# Root domain the AUTH-T / seller-token cookies are shared on (no leading dot)
NEXT_PUBLIC_COOKIE_DOMAIN=uniyel.com

# Local preview without a backend: fake seller session, Storefront Studio runs in local mode
NEXT_PUBLIC_DEMO=0
